{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanduit-contact",
  // Kanduit's Cloudflare account. Pinned so a wrangler session logged into another
  // account (e.g. Istari) cannot deploy or set secrets in the wrong place.
  "account_id": "f6ee15d0b01830aa12bfba8d109d0ad3",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },

  // Serve the Worker at form.kanduit.de (requires kanduit.de zone on Cloudflare).
  // wrangler provisions the custom domain + TLS on deploy.
  "routes": [
    { "pattern": "form.kanduit.de", "custom_domain": true }
  ],

  // Secrets (set once each, never committed):
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put TURNSTILE_SECRET   <- required; Worker rejects all posts without it
  //
  // Per-IP rate limiting, 3 posts per hour (created 2026-11-22 with
  // `npx wrangler kv namespace create RL`). Turnstile is the primary gate; this is
  // defence in depth. Without the binding the Worker still runs, just unlimited.
  "kv_namespaces": [
    { "binding": "RL", "id": "b133b8bb12064259b8d9f499e98d988d" }
  ],

  "vars": {
    "CONTACT_TO": "julian@kanduit.de",
    // kanduit.de is verified in Resend (EU region, Ireland); mail is DKIM-signed as kanduit.de.
    "CONTACT_FROM": "Kanduit Website <kontakt@kanduit.de>",
    // Enforced server-side (see originAllowed in src/index.js), not just echoed as CORS.
    "ALLOWED_ORIGINS": "https://kanduit.de,https://www.kanduit.de,http://127.0.0.1:4321,http://localhost:4321"
  }
}
