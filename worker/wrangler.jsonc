{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanduit-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },

  // Serve the Worker at form.kanduit.de (requires kanduit.de zone on Cloudflare).
  // wrangler provisions the custom domain + TLS on deploy.
  "routes": [
    { "pattern": "form.kanduit.de", "custom_domain": true }
  ],

  // Email delivery via Resend (EU). Set the key once:  npx wrangler secret put RESEND_API_KEY
  "vars": {
    "CONTACT_TO": "julian@kanduit.de",
    "CONTACT_FROM": "Kanduit Website <onboarding@resend.dev>",
    "ALLOWED_ORIGINS": "https://kanduit.de,https://www.kanduit.de,http://127.0.0.1:4321,http://localhost:4321"
  }
}
